generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductApproval {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum OrderStatus {
  pending
  pending_order
  pending_payment
  pending_verification
  payment_confirmed
  processing
  dispatched
  delivered
  cancelled
  rejected
}

enum PaymentMethod {
  opay
  cod
}

enum ReportStatus {
  pending
  reviewed
  resolved
  approved
  rejected
}

model User {
  id                    String          @id @default(cuid())
  fullName              String
  businessName          String?
  phone                 String          @unique
  whatsAppNumber        String?
  email                 String          @unique
  passwordHash          String
  address               String          @default("")
  businessAddress       String?
  city                  String          @default("Kano City")
  state                 String          @default("Kano State")
  area                  String          @default("Kano Municipal")
  productCategory       String?
  role                  Role
  status                AccountStatus   @default(PENDING)
  profileImage          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sessions              Session[]
  products              Product[]
  reviews               ProductReview[]
  buyerOrders           Order[]         @relation("BuyerOrders")
  sellerOrders          Order[]         @relation("SellerOrders")
  cart                  Cart?
  productReports        ProductReport[] @relation("ReporterProductReports")
  buyerReportsFiled     BuyerReport[]   @relation("SellerBuyerReports")
  buyerReportsReceived  BuyerReport[]   @relation("BuyerReportsOnBuyer")
  sellerReportsFiled    SellerReport[]  @relation("BuyerSellerReports")
  sellerReportsReceived SellerReport[]  @relation("SellerReportsOnSeller")

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  hausaName   String?
  description String?
  iconName    String    @default("ShoppingBag")
  image       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                 String          @id @default(cuid())
  name               String
  category           String
  categoryId         String?
  price              Decimal         @db.Decimal(12, 2)
  originalPrice      Decimal         @default(0) @db.Decimal(12, 2)
  discountPercentage Int             @default(0)
  image              String
  images             Json            @default("[]")
  colors             Json            @default("[]")
  sizes              Json            @default("[]")
  variations         Json            @default("[]")
  badge              String?
  stockQuantity      Int             @default(0)
  isFlashSale        Boolean         @default(false)
  isPopular          Boolean         @default(false)
  isNew              Boolean         @default(false)
  isSpecialOffer     Boolean         @default(false)
  description        String          @default("")
  sellerId           String
  approvalStatus     ProductApproval @default(PENDING_APPROVAL)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  seller             User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  categoryRef        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews            ProductReview[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  flashSales         FlashSaleProduct[]
  reports            ProductReport[]

  @@index([approvalStatus, createdAt])
  @@index([sellerId, createdAt])
  @@index([category])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
  @@index([productId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int
  selectedColor     String?
  selectedSize      String?
  selectedVariation String?
  cart              Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Order {
  id                    String             @id @default(cuid())
  orderNumber           String             @unique
  buyerId               String
  sellerId              String?
  buyerName             String
  buyerEmail            String
  buyerPhone            String
  sellerName            String             @default("")
  sellerBusinessName    String             @default("")
  sellerPhone           String             @default("")
  sellerWhatsApp        String             @default("")
  subtotal              Decimal            @db.Decimal(12, 2)
  deliveryFee           Decimal            @db.Decimal(12, 2)
  totalAmount           Decimal            @db.Decimal(12, 2)
  shippingAddress       Json
  paymentMethod         PaymentMethod
  status                OrderStatus
  paymentConfirmation   Json
  adminRejectionReason  String?
  sellerRejectionReason String?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  buyer                 User               @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller                User?              @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  trackingTimeline      OrderTrackingStep[]
  buyerReports          BuyerReport[]
  sellerReports         SellerReport[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  productSnapshot   Json
  quantity          Int
  selectedColor     String?
  selectedSize      String?
  selectedVariation String?
  unitPrice         Decimal  @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderTrackingStep {
  id          String   @id @default(cuid())
  orderId     String
  title       String
  dateLabel   String
  completed   Boolean  @default(false)
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
}

model ProductReport {
  id         String       @id @default(cuid())
  productId  String
  reporterId String
  reason     String
  details    String
  status     ReportStatus @default(pending)
  adminNotes String?
  createdAt  DateTime     @default(now())
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User         @relation("ReporterProductReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model BuyerReport {
  id          String       @id @default(cuid())
  sellerId    String
  buyerId     String
  orderId     String?
  orderNumber String?
  reason      String
  details     String
  status      ReportStatus @default(pending)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  seller      User         @relation("SellerBuyerReports", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer       User         @relation("BuyerReportsOnBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([status, createdAt])
}

model SellerReport {
  id          String       @id @default(cuid())
  buyerId     String
  sellerId    String
  orderId     String?
  orderNumber String?
  reason      String
  details     String
  status      ReportStatus @default(pending)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  buyer       User         @relation("BuyerSellerReports", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User         @relation("SellerReportsOnSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, createdAt])
}

model FlashSale {
  id                 String             @id @default(cuid())
  title              String
  description        String?
  bannerImage        String?
  discountPercentage Int
  startTime          DateTime
  endTime            DateTime
  isActive           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  products           FlashSaleProduct[]

  @@index([isActive, startTime, endTime])
}

model FlashSaleProduct {
  flashSaleId String
  productId   String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([flashSaleId, productId])
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String
  badge       String?
  image       String
  linkText    String?
  linkUrl     String?
  discountTag String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   @default("info")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
